{
  "name": "mastermind",
  "description": "Mastermind code-breaking game in the browser, built with Aurelia 2.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jussimattila-monad/mastermind.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aurelia/i18n": "2.0.0-rc.2",
    "aurelia": "2.0.0-rc.2"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "2.0.0-rc.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint:js": "eslint \"{src,e2e}/**/*.ts\" playwright.config.ts",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "typecheck": "tsc",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "type": "module"
}
