{
  "name": "mastermind",
  "description": "Mastermind game built with Aurelia 2.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jussimattila-monad/mastermind.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aurelia/router": "2.0.0-rc.2",
    "aurelia": "2.0.0-rc.2"
  },
  "devDependencies": {
    "@aurelia/testing": "2.0.0-rc.2",
    "@aurelia/vite-plugin": "2.0.0-rc.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint:js": "eslint \"src/**/*.{js,ts}\"",
